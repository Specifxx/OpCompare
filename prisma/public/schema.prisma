// OP COMPARE'S PUBLIC DATA: the catalogue, prices and eBay state.
//
// This is NOT in Neon (owner, 2026-10-14: "offload everything public from Neon
// to GitHub"). It is the WORKING COPY a job builds on its own runner: a throwaway
// Postgres (a service container in the workflow, PUBLIC_DATABASE_URL) is seeded
// from the `snapshot` branch on GitHub, the import / eBay pass / alerts run
// against it with the same code and SQL as always, and the result is published
// back to the branch. The branch is the only copy that persists. Neon keeps what
// is private: accounts, alerts, collections, the inbox, Stripe, run records.
//
// Generated to src/generated/public-client (prisma generate --schema
// prisma/public/schema.prisma) and used only through src/lib/pubdb.ts, never by
// a page, a route or a component (tests/public-data.test.ts).

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/public-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PUBLIC_DATABASE_URL")
}

model Set {
  id          Int       @id // TCGplayer groupId
  slug        String    @unique
  code        String // "OP01", "ST-01", "EB-01", "OP-PR"
  name        String // "Romance Dawn"
  tcgName     String    @default("") // TCGplayer's own group name: "ST-01: Starter Deck 1 Straw Hat Crew"
  kind        String // booster | extra | premium | starter | promo | event | collection
  releasedOn  DateTime?
  cardCount   Int       @default(0)
  sealedCount Int       @default(0)
  updatedAt   DateTime  @updatedAt
  cards       Card[]
  sealed      Sealed[]
}

model Card {
  id           Int      @id // TCGplayer productId — one printing
  slug         String   @unique
  name         String // display name, variant suffixes removed: "Monkey.D.Luffy"
  tcgName      String // TCGplayer's own product name
  number       String? // "OP01-003"; null only for DON!! cards
  setId        Int
  set          Set      @relation(fields: [setId], references: [id])
  rarity       String? // L C UC R SR SEC PR TR DON!!
  variant      String? // "Parallel", "Manga · Alternate Art", "SP", "Reprint"… null = standard print
  printing     String // standard | alt | manga | sp | treasure | reprint | promo | foil | don
  colors       String[]
  cardType     String? // Leader | Character | Event | Stage | DON!!
  cost         Int?
  power        Int?
  counter      Int?
  life         Int?
  attribute    String?
  subtypes     String[]
  effect       String?
  finish       String? // TCGplayer price subtype: Normal | Foil
  hasImage     Boolean  @default(true)
  tcgplayerUrl String

  // TCGplayer's market price (USD cents) — a REFERENCE, never a listing.
  marketUsd Int?
  // Cheapest OPEN listing per market, in that market's currency (cents) — any
  // source, TCGplayer and eBay included — and how many real stores (`store:`
  // rows only) have one. Written by the import from Offer rows.
  lowUS     Int?
  lowAU     Int?
  lowUK     Int?
  lowSG     Int?
  lowCA     Int?
  lowEU     Int?
  storesUS  Int      @default(0)
  storesAU  Int      @default(0)
  storesUK  Int      @default(0)
  storesSG  Int      @default(0)
  storesCA  Int      @default(0)
  storesEU  Int      @default(0)
  // TCGplayer market price change against ~7 and ~30 days ago, percent.
  change7d  Float?
  change30d Float?
  // Highest market price in the last 90 days (USD cents) — "best value" movers.
  high90Usd Int?
  firstSeen DateTime @default(now())
  updatedAt DateTime @updatedAt



  @@index([setId])
  @@index([number])
  @@index([marketUsd])
}

model Sealed {
  id           Int       @id // TCGplayer productId
  slug         String    @unique
  name         String
  setId        Int?
  set          Set?      @relation(fields: [setId], references: [id])
  kind         String // Booster Box | Booster Case | Booster Pack | Starter Deck | …
  packCount    Int?
  imageUrl     String?
  tcgplayerUrl String
  releasedOn   DateTime?
  presale      Boolean   @default(false)
  marketUsd    Int?
  lowUS        Int?
  lowAU        Int?
  lowUK        Int?
  lowSG        Int?
  lowCA        Int?
  lowEU        Int?
  storesUS     Int       @default(0)
  storesAU     Int       @default(0)
  storesUK     Int       @default(0)
  storesSG     Int       @default(0)
  storesCA     Int       @default(0)
  storesEU     Int       @default(0)
  change7d     Float?
  firstSeen    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt


  @@index([setId])
}

model Offer {
  id            String   @id @default(cuid())
  productId     Int
  source        String // "tcgplayer" | "store:<key>" | "ebay" | "ebay_us" (CA rows derived from the US eBay search)
  market        String // US AU UK SG CA EU
  priceCents    Int // in `currency` (eBay: the ITEM price, postage separate)
  currency      String
  url           String
  inStock       Boolean
  condition     String?
  title         String? // the store's own listing title, kept for audits
  shippingCents Int? // eBay only: first shipping option in `currency`; null = unknown / at checkout
  updatedAt     DateTime

  @@unique([productId, source, market])
  @@index([market, productId])
  @@index([source])
}

model EbayCheck {
  productId Int
  market    String
  checkedAt DateTime
  matched   Boolean

  @@id([productId, market])
  @@index([checkedAt])
}

model EbayListing {
  id            String   @id @default(cuid())
  productId     Int
  market        String
  rank          Int
  priceCents    Int
  shippingCents Int?
  currency      String
  url           String
  title         String
  imageUrl      String?
  updatedAt     DateTime

  @@unique([productId, market, rank])
  @@index([market, rank])
}

model EbayGradedListing {
  id            String   @id @default(cuid())
  productId     Int
  market        String
  itemId        String
  priceCents    Int
  shippingCents Int?
  currency      String
  url           String
  title         String
  imageUrl      String?
  grader        String
  grade         String
  updatedAt     DateTime

  @@unique([itemId, market])
  @@index([productId, market])
}
