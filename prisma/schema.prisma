// OP Compare — One Piece Card Game prices.
//
// ONE database (a Neon project of its own; DATABASE_URL). Nothing here is
// shared with RiftCompare: the Riftbound databases are never read or written.
//
// The catalogue is TCGplayer's, mirrored daily by TCGCSV (category 68 = One
// Piece Card Game). A Card is ONE PRINTING — TCGplayer's own product — so the
// base OP01-120 Shanks, its Parallel and its Manga art are three rows that share
// a `number`. Ids are TCGplayer product/group ids, stable for life.
//
// EGRESS: every page reads through the self-cached loaders in src/lib/data.ts
// (unstable_cache, tag "prices", purged by the import). Read the rules at the
// top of src/lib/db.ts before adding a query to a request path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Set {
  id          Int       @id // TCGplayer groupId
  slug        String    @unique
  code        String // "OP01", "ST-01", "EB-01", "OP-PR"
  name        String // "Romance Dawn"
  tcgName     String @default("") // TCGplayer's own group name: "ST-01: Starter Deck 1 Straw Hat Crew"
  kind        String // booster | extra | premium | starter | promo | event | collection
  releasedOn  DateTime?
  cardCount   Int       @default(0)
  sealedCount Int       @default(0)
  updatedAt   DateTime  @updatedAt
  cards       Card[]
  sealed      Sealed[]
}

model Card {
  id           Int       @id // TCGplayer productId — one printing
  slug         String    @unique
  name         String // display name, variant suffixes removed: "Monkey.D.Luffy"
  tcgName      String // TCGplayer's own product name
  number       String? // "OP01-003"; null only for DON!! cards
  setId        Int
  set          Set       @relation(fields: [setId], references: [id])
  rarity       String? // L C UC R SR SEC PR TR DON!!
  variant      String? // "Parallel", "Manga · Alternate Art", "SP", "Reprint"… null = standard print
  printing     String // standard | alt | manga | sp | treasure | reprint | promo | foil | don
  colors       String[]
  cardType     String? // Leader | Character | Event | Stage | DON!!
  cost         Int?
  power        Int?
  counter      Int?
  life         Int?
  attribute    String?
  subtypes     String[]
  effect       String?
  finish       String? // TCGplayer price subtype: Normal | Foil
  hasImage     Boolean   @default(true)
  tcgplayerUrl String

  // TCGplayer's market price (USD cents) — a REFERENCE, never a listing.
  marketUsd    Int?
  // Cheapest OPEN listing per market, in that market's currency (cents) — any
  // source, TCGplayer and eBay included — and how many real stores (`store:`
  // rows only) have one. Written by the import from Offer rows.
  lowUS        Int?
  lowAU        Int?
  lowUK        Int?
  lowSG        Int?
  lowCA        Int?
  lowEU        Int?
  storesUS     Int       @default(0)
  storesAU     Int       @default(0)
  storesUK     Int       @default(0)
  storesSG     Int       @default(0)
  storesCA     Int       @default(0)
  storesEU     Int       @default(0)
  // TCGplayer market price change against ~7 and ~30 days ago, percent.
  change7d     Float?
  change30d    Float?
  // Highest market price in the last 90 days (USD cents) — "best value" movers.
  high90Usd    Int?
  firstSeen    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([setId])
  @@index([number])
  @@index([marketUsd])
}

model Sealed {
  id           Int       @id // TCGplayer productId
  slug         String    @unique
  name         String
  setId        Int?
  set          Set?      @relation(fields: [setId], references: [id])
  kind         String // Booster Box | Booster Case | Booster Pack | Starter Deck | …
  packCount    Int?
  imageUrl     String?
  tcgplayerUrl String
  releasedOn   DateTime?
  presale      Boolean   @default(false)
  marketUsd    Int?
  lowUS        Int?
  lowAU        Int?
  lowUK        Int?
  lowSG        Int?
  lowCA        Int?
  lowEU        Int?
  storesUS     Int       @default(0)
  storesAU     Int       @default(0)
  storesUK     Int       @default(0)
  storesSG     Int       @default(0)
  storesCA     Int       @default(0)
  storesEU     Int       @default(0)
  change7d     Float?
  firstSeen    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([setId])
}

// One store's (or TCGplayer's) offer for one product in one market. Card and
// sealed ids are both TCGplayer product ids, so one table serves both.
model Offer {
  id         String   @id @default(cuid())
  productId  Int
  source     String // "tcgplayer" | "store:<key>" | "ebay" | "ebay_us" (CA rows derived from the US eBay search)
  market     String // US AU UK SG CA EU
  priceCents Int // in `currency` (eBay: the ITEM price, postage separate)
  currency   String
  url        String
  inStock    Boolean
  condition  String?
  title      String? // the store's own listing title, kept for audits
  shippingCents Int? // eBay only: first shipping option in `currency`; null = unknown / at checkout
  updatedAt  DateTime

  @@unique([productId, source, market])
  @@index([market, productId])
  @@index([source])
}

// One row per (product, market) the eBay pass (scripts/ebay.ts) has searched.
// Drives "due": a pair with no row has never been searched. Written only after
// a COMPLETED search, so a run cut short leaves the pairs it missed due.
model EbayCheck {
  productId Int
  market    String
  checkedAt DateTime
  matched   Boolean

  @@id([productId, market])
  @@index([checkedAt])
}


model ImportRun {
  id         Int       @id @default(autoincrement())
  kind       String // "full" | "catalog" | "stores" | "ebay"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    Json?
}

// ── Accounts and Premium (ported from RiftCompare) ──────────────────────────
// Sign-in is Google / Discord OAuth only, with a signed JWT cookie (no session
// table). Entitlement is a date: premiumUntil, extended (never shortened) by
// the Stripe webhook and the daily reconcile, and premiumTier from the Price.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  displayName      String
  avatarUrl        String?
  emailVerified    DateTime?
  googleId         String?
  discordId        String?
  isAdmin          Boolean   @default(false)
  premiumUntil     DateTime?
  premiumTier      String    @default("premium")
  stripeCustomerId String?
  createdAt        DateTime  @default(now())
  lastLoginAt      DateTime?

  @@index([googleId])
  @@index([discordId])
  @@index([stripeCustomerId])
}

// Small key/value settings the import writes and the site reads. "historyRef":
// the `data`-branch commit holding the current price history (lib/history.ts).
model Meta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Inbox (admin port from RiftCompare) ─────────────────────────────────────
// What visitors send: wrong-price reports, store suggestions, feedback and
// contact messages, read in /admin/inbox. Written only through src/lib/inbox.ts.
// No IP address is stored anywhere, and no row has a foreign key to User, so
// deleting an account never cascades through the inbox.
model PriceReport {
  id              String   @id @default(cuid())
  productId       Int // TCGplayer id: Card.id or Sealed.id
  kind            String // "card" | "sealed"
  source          String // Offer.source, e.g. "store:foo" | "tcgplayer"
  market          String
  storeName       String // from stores.ts sourceLabel(source), never from the request
  shownPriceCents Int? // Offer.priceCents read server-side; null if the offer is gone
  currency        String?
  listingTitle    String? // Offer.title snapshot, for tests/match.test.ts
  listingUrl      String?
  issue           String // REPORT_ISSUES (lib/inbox-rules.ts)
  claimedCents    Int?
  note            String?
  userId          String?
  page            String?
  status          String   @default("NEW") // NEW | CONFIRMED | REJECTED | FIXED
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([productId])
}

model StoreSuggestion {
  id        String   @id @default(cuid())
  storeName String
  storeUrl  String // https://<bare host>
  country   String // a MARKETS code or "OTHER"
  note      String?
  userId    String?
  status    String   @default("pending") // pending | added | rejected
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([storeUrl])
}

model Feedback {
  id            String    @id @default(cuid())
  userId        String?
  rating        Int? // 1–5
  message       String // may be "" when only a rating was given
  displayName   String? // stored only with consentPublic
  consentPublic Boolean   @default(false)
  page          String?
  source        String    @default("page") // page | widget
  status        String    @default("NEW") // NEW | APPROVED | HIDDEN | SPAM
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([status, publishedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String // the visitor typed it so the owner can reply by hand
  subject   String?
  category  String   @default("OTHER") // PAYMENT | ACCOUNT | PRICE_OR_STORE | OTHER
  message   String
  userId    String?
  status    String   @default("NEW") // NEW | DONE
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
