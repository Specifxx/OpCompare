# OP Compare — copy to .env for local development.

# Postgres (a Neon project of its own in production — never a RiftCompare database).
DATABASE_URL="postgresql://op:op@localhost:5432/opcompare"

# Shared secret for POST /api/revalidate (the import calls it after every run).
CRON_SECRET="change-me"

# The public site URL (canonical links, sitemap, Open Graph); also used by the
# import to find /api/revalidate. Production is https://opcompare.app (the code's
# default too).
NEXT_PUBLIC_SITE_URL="https://opcompare.app"

# Accounts (lib/auth.ts): a long random string; production refuses to start a
# session without one.
AUTH_SECRET="change-me"
# Sign-in providers — each switches on when both its values are set.
# Redirect URIs: https://opcompare.app/api/auth/oauth/{google,discord}/callback
# GOOGLE_CLIENT_ID=""  GOOGLE_CLIENT_SECRET=""
# DISCORD_CLIENT_ID="" DISCORD_CLIENT_SECRET=""
# Owner accounts (comma-separated emails) — treated as Premium.
# ADMIN_EMAILS="you@example.com"

# Plus & Premium (lib/stripe.ts). OP Compare's OWN Stripe account; prices come
# from Stripe by lookup key (scripts/stripe-setup.ts creates them).
# STRIPE_SECRET_KEY="sk_live_…"
# STRIPE_WEBHOOK_SECRET="whsec_…"   # endpoint: https://opcompare.app/api/stripe/webhook

# Price history (lib/history.ts) lives in GitHub, on the `data` branch. The
# import writes it to HISTORY_DIR; in development the site can read that local
# copy instead of GitHub.
# HISTORY_DIR=".data/history"
# HISTORY_LOCAL_DIR=".data/history"

# Optional overrides
# NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"
# EBAY_AFFILIATE_CAMPAIGN="5339155912"        # EPN campaign id for search links (no API use)
# TCGPLAYER_IMPACT_LINK="https://partner.tcgplayer.com/c/…"
# NEXT_PUBLIC_USD_TO_AUD=1.5  NEXT_PUBLIC_USD_TO_GBP=0.79  NEXT_PUBLIC_USD_TO_SGD=1.35
# NEXT_PUBLIC_USD_TO_CAD=1.37 NEXT_PUBLIC_USD_TO_EUR=0.92

# Dev only: reuse downloaded TCGCSV files between imports.
# TCGCSV_CACHE_DIR=".cache"
